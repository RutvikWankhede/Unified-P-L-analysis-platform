# ==============================================================================
# Unified P&L Intelligence Platform - Root Environment Configuration Example
# Copy this file to .env or backend/.env and configure as needed.
# ==============================================================================

# Database Configuration
DATABASE_MODE=sqlite
DATABASE_URL=sqlite:///./enterprise_pl.db

# Security & Authentication
SECRET_KEY=change-this-to-a-secure-random-32-byte-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS / Allowed Origins (comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Optional AI Features API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=

# Domain Anomaly Contamination Rates (defaults)
CONTAM_RETAIL=0.03
CONTAM_CORPORATE=0.05
CONTAM_INVESTMENT=0.08
CONTAM_SME=0.04
