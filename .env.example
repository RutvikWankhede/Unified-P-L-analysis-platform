# Unified P&L Intelligence Platform Environment Configuration

# Application & Network Environment
APP_ENV=development
HOST=0.0.0.0
PORT=8000
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Database Configuration (Defaults to persistent SQLite volume)
DATABASE_MODE=sqlite
DATABASE_URL=sqlite:////app/data/enterprise_pl.db

# Security & Authentication
SECRET_KEY=supersecretkey-unified-pl-2025-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# AI Provider API Keys (Optional - System works deterministically without external LLMs)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Platform Feature Flags
ENABLE_COPILOT=true
ENABLE_FORECAST_ENGINE=true
ENABLE_RECOMMENDATIONS=true
ENABLE_NOTIFICATIONS=true
